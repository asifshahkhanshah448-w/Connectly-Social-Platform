# ==============================================================================
# Environment Configuration Template
# Connectly / CONNECT - Full-Stack Social Media Platform
# Copy this file to .env and fill in your values
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
# Leave empty to use the auto-provisioned embedded MongoDB daemon for local testing,
# or paste your genuine MongoDB Atlas connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/connect_platform?retryWrites=true&w=majority

# Authentication Security (JWT)
# Provide a 256-bit (or min 32-character) random secret string
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Application URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
