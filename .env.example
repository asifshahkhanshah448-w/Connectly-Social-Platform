# Connectly Environment Variables Configuration
# Copy this file to .env.local or set these in your hosting environment (Vercel, Railway, etc.)

# MongoDB Atlas Connection URI (Required for persistent MongoDB Atlas storage)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/connectly?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/connectly?retryWrites=true&w=majority"

# JWT Secret Key for token signing and verification (Required for production authentication)
JWT_SECRET="connectly_super_secure_jwt_secret_key_change_me_in_production"

# Port for standalone Express server (default: 5000)
PORT=5000

# Frontend URL (for CORS and external redirect verification if decoupled)
FRONTEND_URL="http://localhost:3000"

# Optional App URL
APP_URL="http://localhost:3000"

# Gemini AI API Key (Injected automatically in AI Studio runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
